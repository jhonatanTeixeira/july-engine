# Dev image: same base OS/libc as the host (Pop!_OS 24.04 == Ubuntu 24.04 "noble",
# glibc 2.39) so the venv built on the host with `/usr/bin/python3.11 -m venv --copies
# .venv && ./setup.sh` (see CLAUDE.md — setup.sh compiles llama-cpp-python with CUDA and
# caches the wheel under vendor/.../dist, then pip-installs requirements.txt) runs
# unmodified when bind-mounted in. Use `/usr/bin/python3.11` explicitly, NOT a bare
# `python3.11` — if pyenv (or any user-local build) shadows it earlier on $PATH,
# `venv --copies` silently copies pyenv's interpreter instead, whose `.venv/bin/python3.11`
# is itself a symlink into `~/.pyenv/...` rather than a real standalone copy; that path
# doesn't exist inside the container, so the venv looks present on the host but fails
# the executable check below once bind-mounted in. This image never copies the source
# tree, never creates a venv,
# and never installs a single Python dependency itself — only the CUDA runtime libs and
# system packages the venv's compiled extensions (llama-cpp-python w/ CUDA, opencv,
# deepface/insightface, pytesseract) need to actually run. That's the entire point of
# this rewrite: the previous version COPYed requirements.txt/vendor/setup.sh (vendor/
# alone is 1.1G) and ran the full CUDA compile inside the build — slow, and it baked a
# second, redundant multi-GB venv (.venv_docker) into the image on top of it.
#
# CUDA 12.6.3 "runtime" (not "devel") variant: no compiler toolchain/headers baked in —
# compiling only ever happens on the host via ./setup.sh. "runtime" (unlike the leaner
# "base" tag) does include cuBLAS/cuFFT/cuRAND/cuSPARSE, which the CUDA-enabled
# llama-cpp-python build links against. ubuntu24.04 (not the previous ubuntu22.04) to
# match the host's glibc exactly, same reasoning as every other Python service's
# Dockerfile.dev in this monorepo (see CRM/CLAUDE.md's "Local dev with hot reload").
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# python3.11 (this repo's pinned dev Python, not Ubuntu Noble's default python3.12) from
# the deadsnakes PPA — needed so the venv's --copies python3.11 binary (dynamically
# linked against libpython3.11.so) has a matching interpreter/shared-lib installed to
# resolve against, even though this image never runs it directly. libgl1/libglib2.0-0/
# libgomp1 for opencv/deepface/insightface; tesseract-ocr(+por) for pytesseract, always
# installed here (not gated like setup.sh's host-side SETUP_UBUNTU=true) since the
# served app can hit an OCR request at any time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common gnupg ca-certificates curl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    tesseract-ocr \
    tesseract-ocr-por \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

EXPOSE 8000

# Invoked as `python -m uvicorn`, not the `uvicorn` console-script: that script's shebang
# bakes in the absolute path the venv was created at on the host, which doesn't exist
# inside the container, while `python` resolved via PATH is the real --copies binary and
# works regardless of mount path (same reasoning as every other Python service's
# Dockerfile.dev here — see CRM/CLAUDE.md). The .venv existence check gives a clear,
# actionable error instead of the opaque "exec: python: executable file not found in
# $PATH" OCI error a bare python3.11 install produces.
#
# No compose file wires this service up yet (july-engine is run standalone) — build and
# run it with:
#   docker build -f Dockerfile.dev -t july-engine:dev .
#   docker run --rm --gpus all -p 8000:8000 -v "$(pwd)":/app july-engine:dev
CMD ["sh", "-c", "test -x /app/.venv/bin/python || { echo 'ERROR: /app/.venv not found (or unusable — check it was built with /usr/bin/python3.11, not pyenv). On the host, run: /usr/bin/python3.11 -m venv --copies .venv && ./setup.sh' >&2; exit 1; }; exec python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"]
